# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

# Required. Postgres connection string. For local testing against the "Training-Matrix-db"
# Render Postgres instance, use its EXTERNAL Database URL (Render dashboard -> Training-Matrix-db
# -> Connections -> External Database URL) - the Internal one only works from inside Render.
DATABASE_URL=

# Optional locally (defaults to ./data). Where certificate/roster PDFs are written.
DATA_DIR=

# Optional. Creates the first login account on first boot if no accounts exist yet.
APP_USERNAME=
APP_PASSWORD=

# Optional. Needed for Training Sign-In QR codes to point somewhere reachable - not required
# for general local testing.
PUBLIC_APP_URL=

# Optional. Only needed for Training Sign-In's Spanish translation feature.
DEEPL_API_KEY=
